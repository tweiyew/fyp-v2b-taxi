<mxfile host="app.diagrams.net" agent="fyp-v2b" version="24.7.17">
  <diagram id="attacker-mdp" name="Attacker MDP">
    <mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Attacker MDP: a learned false-data-injection attack on the fleet scheduler&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="30" as="geometry"/></mxCell>
        <mxCell id="sub" value="The adversary is the RL agent; the taxi simulator is the environment; the victim scheduler acts on whatever telemetry it is handed." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1080" height="22" as="geometry"/></mxCell>
        <mxCell id="atk" value="&lt;b&gt;Attacker &amp;#960;&lt;sub&gt;a&lt;/sub&gt;&lt;/b&gt; &amp;#183; RL agent (PPO)&lt;br/&gt;&lt;br/&gt;Learns the false-report policy.&lt;br/&gt;Compromises a fixed set &lt;b&gt;C&lt;/b&gt; of taxis,&lt;br/&gt;budget &lt;b&gt;b = |C|&lt;/b&gt;.&lt;br/&gt;Cannot change physics or taxis outside C." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;spacing=4;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="70" y="360" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br/&gt;&amp;#960;&lt;sub&gt;a&lt;/sub&gt; trained with PPO (already in repo).&lt;br/&gt;&amp;#960;&lt;sub&gt;v&lt;/sub&gt; is fixed within an episode;&lt;br/&gt;swept across the 80-20 rule and the DNN.&lt;br/&gt;Episode: a representative day or week." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#cccccc;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="545" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="env" value="&lt;b&gt;Environment: taxi fleet simulator&lt;/b&gt; &amp;#160;&amp;#160; (1 tick = 1 hour)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontStyle=1;fontSize=13;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="690" height="630" as="geometry"/></mxCell>
        <mxCell id="A" value="&lt;b&gt;Reported telemetry&lt;/b&gt; (the attack surface)&lt;br/&gt;true (SoC, SoH) of C replaced by&lt;br/&gt;SoC+&amp;#948;, SoH+&amp;#949;, declared session energy&lt;br/&gt;bound |&amp;#948;| &amp;#8804; &amp;#916;, time-consistent&lt;br/&gt;&lt;i&gt;injected around simulator.py:45&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;spacing=4;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="470" y="165" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="B" value="&lt;b&gt;Victim scheduler &amp;#960;&lt;sub&gt;v&lt;/sub&gt;&lt;/b&gt; (swept)&lt;br/&gt;80-20 rule, then Paper A DNN;&lt;br/&gt;acts on the &lt;i&gt;reported&lt;/i&gt; state &amp;#8594;&lt;br/&gt;charge flag, rate, V2B discharge" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;spacing=4;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="295" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="C" value="&lt;b&gt;Fleet &amp;amp; true batteries&lt;/b&gt; (physics)&lt;br/&gt;charge / discharge / drive at the&lt;br/&gt;O'Hare V2B queue;&lt;br/&gt;true SoC, SoH, peak shaving evolve" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;spacing=4;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="425" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="D" value="&lt;b&gt;Meter + detector&lt;/b&gt; (Paper B)&lt;br/&gt;delivered kWh metered (charger.py:128);&lt;br/&gt;screen report vs meter &amp;#8594; score &lt;b&gt;d&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;spacing=4;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="470" y="560" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="Ebx" value="&lt;b&gt;Demand replay + building load L&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;&lt;br/&gt;Chicago Jan 2019 trips;&lt;br/&gt;OpenEI O'Hare office / hotel" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;spacing=4;arcSize=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="810" y="425" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="F" value="&lt;b&gt;Reward&lt;/b&gt; &amp;#160; r&lt;sub&gt;t&lt;/sub&gt; = D&lt;sub&gt;t&lt;/sub&gt; - &amp;#955;&amp;#183;d&lt;sub&gt;t&lt;/sub&gt;&lt;br/&gt;D&lt;sub&gt;t&lt;/sub&gt; = V2B peak shaving removed (headline)&lt;br/&gt;alt: grid stress, degradation, diverted pay&lt;br/&gt;&amp;#955; sweeps damage vs stealth" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;spacing=4;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="810" y="555" width="270" height="95" as="geometry"/></mxCell>
        <mxCell id="eAct" value="&lt;b&gt;action a&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt; : inject false reports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;fontSize=10;exitX=0.5;exitY=0;entryX=0;entryY=0.5;strokeColor=#b85450;strokeWidth=2.5;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="atk" target="A"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="195" y="207"/></Array></mxGeometry></mxCell>
        <mxCell id="eRet" value="&lt;b&gt;state s&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt; (hour &amp;#183; true SoC/SoH of C &amp;#183; L&lt;sub&gt;t&lt;/sub&gt; &amp;#183; station power &amp;#183; d&lt;sub&gt;t&lt;/sub&gt;) &amp;#160;+&amp;#160; &lt;b&gt;reward r&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=1;strokeColor=#333333;strokeWidth=2.5;fontStyle=1;" edge="1" parent="1" source="env" target="atk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="795"/><mxPoint x="195" y="795"/></Array></mxGeometry></mxCell>
        <mxCell id="eAB" value="reads reports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A" target="B"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="eBC" value="dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="B" target="C"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="eCD" value="metered energy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="C" target="D"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="eEC" value="arrivals, load" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="Ebx" target="C"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="eCF" value="&lt;b&gt;D&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt; : shaving lost vs honest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="C" target="F"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="eDF" value="&lt;b&gt;d&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.78;" edge="1" parent="1" source="D" target="F"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
